# Copy this file to .env.local (which is gitignored) and fill in real values.
# The app reads these at runtime via BrightpearlConfig.from_env() /
# SftpConfig.from_env() etc. Never commit .env.local.

# --- Brightpearl --------------------------------------------------------------
# Account code: the WBYS subdomain in your Brightpearl URL.
#   e.g. https://eu1.brightpearlapp.com/wbys/  ->  wbys
BRIGHTPEARL_ACCOUNT_CODE=

# Datacenter: the subdomain in your Brightpearl API URL.
#   Common values: use1, eu1, ws-eu1, ws-use1
BRIGHTPEARL_DATACENTER=

# App reference: the reference assigned when the app was registered with
# Brightpearl (e.g. wbys_ops_engine).
BRIGHTPEARL_APP_REF=

# Account token: the secret token that authenticates API calls on behalf of
# the Brightpearl app. Treat this like a password.
BRIGHTPEARL_ACCOUNT_TOKEN=

# --- Gardiner Brothers SFTP ---------------------------------------------------
# The WBYS-owned SFTP server that Gardiners read/write files through.
GBR_SFTP_HOST=ec2-63-32-88-8.eu-west-1.compute.amazonaws.com
GBR_SFTP_PORT=22
GBR_SFTP_USERNAME=
GBR_SFTP_PASSWORD=

# --- Gardiner Brothers JIT integration config --------------------------------
# Brightpearl contact ID of the Gardiner Bros & Co (B1358) supplier account.
# NOT the B3116 DF dropship account.
GBR_JIT_SUPPLIER_CONTACT_ID=

# Brightpearl ID of the "Cost Price GBR (Net)" price list. The Gardiners SKU
# for each product is resolved from that price list's SKU field.
GBR_JIT_PRICE_LIST_ID=

# Brightpearl custom-status IDs. Look these up once; then pin here.
# Used by the outbound pipeline:
GBR_JIT_STATUS_ID_REQUEST_SENT=
GBR_JIT_STATUS_ID_PENDING=
# Used by the inbound pipeline (driven by Gardiners notifications):
GBR_JIT_STATUS_ID_ACKNOWLEDGED=
GBR_JIT_STATUS_ID_ORDER_FULFILLED=
GBR_JIT_STATUS_ID_CANCELLED=

# SFTP folders agreed with Gardiners (subject to confirmation with Sam).
GBR_JIT_ORDERS_PATH=/JIT/Orders/
GBR_JIT_NOTIFICATIONS_PATH=/JIT/Notifications/
# Where processed notification files are moved to. Defaults to
# '<NOTIFICATIONS_PATH>/processed/'.
# GBR_JIT_NOTIFICATIONS_PROCESSED_PATH=/JIT/Notifications/processed/

# Optional: override the outbound filename template. Placeholders:
#   {order_reference}  -- the PO's reference (or ID if no reference is set)
#   {timestamp}        -- UTC yyyymmddHHMM at upload time
# GBR_JIT_FILE_NAME_TEMPLATE={order_reference}-{timestamp}.csv

# --- Bobcat stock-feed SFTP ---------------------------------------------------
# Same WBYS-owned SFTP server (wbysltd user); Bobcat's daily CSV lands under
# /home/wbysltd/SupplierStockFeeds/Bobcat/. Credentials are the existing SFTP
# login we already use for the other supplier feeds.
BOBCAT_SFTP_HOST=ec2-63-32-88-8.eu-west-1.compute.amazonaws.com
BOBCAT_SFTP_PORT=22
BOBCAT_SFTP_USERNAME=
BOBCAT_SFTP_PASSWORD=

# --- Bobcat integration config ------------------------------------------------
# Brightpearl warehouse ID the Bobcat stock levels are applied to.
# On the WBYS account this is the Virtual warehouse named "Bobcat" (ID 14).
BOBCAT_WAREHOUSE_ID=14

# Brightpearl location ID INSIDE that warehouse. Every stock correction has
# to target a specific location (shelf/bin). Find it once with:
#   python -m ops_engine.integrations.bobcat list-locations
# and paste the integer id here.
BOBCAT_LOCATION_ID=

# SFTP folder Bobcat drop the daily stock CSV into.
BOBCAT_STOCK_PATH=/home/wbysltd/SupplierStockFeeds/Bobcat/

# Optional: quantity written to Brightpearl when a SKU's +10 Available is
# "Yes". Bobcat guarantee ten or more units, so 10 is the default.
# BOBCAT_IN_STOCK_QUANTITY=10

# Optional: currency code used on stock corrections (Brightpearl requires
# one on each correction). Defaults to GBP.
# BOBCAT_CURRENCY_CODE=GBP

# Optional: where processed files move after we apply them. Defaults to
# '<BOBCAT_STOCK_PATH>/processed/'.
# BOBCAT_STOCK_PROCESSED_PATH=/home/wbysltd/SupplierStockFeeds/Bobcat/processed/

# Optional: filename prefix used to filter the stock folder. Bobcat drop
# files named BC_STOCK_YYYYMMDDHHMMSS.csv; the default matches that pattern.
# BOBCAT_FILE_NAME_PREFIX=BC_STOCK_
